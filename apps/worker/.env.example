# Supabase project for Messages ("Mesages" in the dashboard).
SUPABASE_URL=https://bbfahndgnmdlehicmphe.supabase.co
# Dashboard > Project Settings > API Keys > secret / service_role key. Never commit or share it.
SUPABASE_SERVICE_ROLE_KEY=
# OLD static key, 32 random bytes base64: it used to seal every account sign-in and WhatsApp session. These are now
# sealed with each user's own key, so this is only needed to read rows `pnpm credentials:reseal` has not moved yet (and
# for the web app's short-lived sign-in cookies). Do not lose it until that script reports 0 left. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# How many days of email the first sync imports.
INITIAL_SYNC_DAYS=30
# Google Cloud OAuth client for Gmail and Google Calendar, application type "Desktop app".
# Google Cloud console > Google Auth Platform > Clients. See README.md for the full setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The web app's Google OAuth client, application type "Web application", for Google accounts connected in the
# app (onboarding, Settings). The same two values as in apps/web/.env.local.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Microsoft Entra app for Outlook and Outlook Calendar, platform "Mobile and desktop applications" with
# the redirect URI http://localhost. entra.microsoft.com > App registrations. See README.md for the setup.
MICROSOFT_CLIENT_ID=
# "common" allows work, school and personal Microsoft accounts. Leave it unless you want only one organisation.
MICROSOFT_TENANT=common
# Zoom Marketplace app (General app, user-managed) for Zoom meetings and Team Chat, connected in the app.
# The same two values as in apps/web/.env.local: the worker refreshes the sign-ins made with it.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Wraps each user's data key (base64, 32 bytes). The same value in apps/ai/.env and apps/web/.env.local.
# Losing it makes encrypted messages unreadable: keep a copy in a password manager.
KEY_WRAPPING_KEY=
# Google Cloud KMS key that wraps data keys (kms:v1), e.g.
# projects/messages-keys/locations/africa-south1/keyRings/messages/cryptoKeys/user-data-keys
# When set, new keys are wrapped by KMS and KEY_WRAPPING_KEY is only kept to open rows made before the move
# (pnpm rewrap-keys moves them, then KEY_WRAPPING_KEY can go). Credentials: on a Google Cloud VM the metadata server is
# used; elsewhere set GOOGLE_APPLICATION_CREDENTIALS_JSON (a service account key with Cloud KMS Encrypter/Decrypter).
KMS_KEY_NAME=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Encryption is on unless one of these is "false", and production refuses to start with either off. Content is
# message text, names, titles, locations, notes and attachment names; addresses are emails, numbers and chat IDs.
# Every process reads plain and encrypted values alike.
ENCRYPT_CONTENT=true
ENCRYPT_ADDRESSES=true

# Attachments. Files are sealed in the worker before upload. Videos over this many MB are not copied; the
# original stays at the provider. Each seat keeps this many GB of files (new ones stop at 100%, with 10% grace).
VIDEO_COPY_MAX_MB=25
STORAGE_CAP_GB=20


# "true" finds, frames and saves the shared company logos (src/logos), together with the AI worker (its
# COMPANY_LOGOS). Off until rolled out.
COMPANY_LOGOS=

# Web push (Urgent and Important messages, content-free). Generate a pair with `pnpm --filter worker vapid:generate`.
# The public key is also NEXT_PUBLIC_VAPID_PUBLIC_KEY in apps/web/.env.local. Leave these empty and the sender stays off.
# VAPID_SUBJECT is a mailto: or https: address the push services can reach, e.g. mailto:you@example.com.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Push based mail sync. All optional; with none set, Gmail and Outlook are checked every MAIL_SLOW_POLL_MS and IMAP
# relies on IDLE with a slow safety net. See docs/PLAN.md.
#
# Gmail: a Cloud Pub/Sub topic that Gmail publishes mailbox changes to, and a PULL subscription on it that this worker
# reads (outbound only, no public endpoint). Names look like projects/<project>/topics/<topic> and
# projects/<project>/subscriptions/<name>. Give gmail-api-push@system.gserviceaccount.com the Pub/Sub Publisher role on
# the topic, and the service account in GOOGLE_APPLICATION_CREDENTIALS_JSON (or the VM's identity) the Pub/Sub Subscriber
# role on the subscription. With several workers sharing one subscription, set a short message retention on it.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
# Outlook: the public HTTPS address of the web app's notification route (<app origin>/api/graph/notify) and a long random
# secret that signs each subscription. GRAPH_NOTIFY_SECRET must be the same value in apps/web/.env.local.
GRAPH_NOTIFICATION_URL=
GRAPH_NOTIFY_SECRET=
# Safety-net checks, in milliseconds. Gmail and Outlook: how often to look when push is off or working (default 5 minutes).
# IMAP: the housekeeping tick with IDLE (default 5 minutes) and without it (default 1 minute).
MAIL_SLOW_POLL_MS=300000
IMAP_POLL_MS=300000
IMAP_NO_IDLE_POLL_MS=60000
# WhatsApp send safety (all optional; the defaults are cautious). Gaps are in seconds. A cap below 1 is ignored.
# WHATSAPP_MIN_GAP_SECONDS=6
# WHATSAPP_GAP_JITTER_SECONDS=6
# WHATSAPP_PART_GAP_SECONDS=2
# WHATSAPP_TYPING_MAX_SECONDS=8
# WHATSAPP_DAILY_CAP=300
# WHATSAPP_NEW_CHAT_CAP=20
