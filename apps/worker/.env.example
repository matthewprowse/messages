# Supabase project for Messages ("Mesages" in the dashboard).
SUPABASE_URL=https://bbfahndgnmdlehicmphe.supabase.co
# Dashboard > Project Settings > API Keys > secret / service_role key. Never commit or share it.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Encrypts account passwords and WhatsApp session keys before they reach Supabase.
# Losing it means reconnecting every account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# How many days of email the first sync imports.
INITIAL_SYNC_DAYS=30
# Google Cloud OAuth client for Gmail and Google Calendar, application type "Desktop app".
# Google Cloud console > Google Auth Platform > Clients. See README.md for the full setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wraps each user's data key (base64, 32 bytes). The same value in apps/ai/.env and apps/web/.env.local.
# Losing it makes encrypted messages unreadable: keep a copy in a password manager.
KEY_WRAPPING_KEY=
# "true" stores new message text encrypted. Every process reads both kinds either way.
ENCRYPT_CONTENT=false
