NEXT_PUBLIC_SUPABASE_URL=https://bbfahndgnmdlehicmphe.supabase.co
# Dashboard > Project Settings > API Keys > publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, for /api/keys, which hands a signed-in user their data key: the same values as apps/worker/.env.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
KEY_WRAPPING_KEY=
# Google Cloud KMS key that wraps data keys (kms:v1), e.g.
# projects/messages-keys/locations/africa-south1/keyRings/messages/cryptoKeys/user-data-keys
# The same values as apps/worker/.env. When set, new keys are wrapped by KMS and KEY_WRAPPING_KEY is only kept to open rows made before the move
# (pnpm rewrap-keys moves them, then KEY_WRAPPING_KEY can go). Credentials: on a Google Cloud VM the metadata server is
# used; on Vercel set GOOGLE_APPLICATION_CREDENTIALS_JSON (a service account key with Cloud KMS Encrypter/Decrypter).
KMS_KEY_NAME=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Encryption is on unless one of these is "false", and production refuses to start with either off. Keep each
# the same as ENCRYPT_CONTENT and ENCRYPT_ADDRESSES in the workers. Readers open plain and encrypted values alike.
NEXT_PUBLIC_ENCRYPT_CONTENT=true
NEXT_PUBLIC_ENCRYPT_ADDRESSES=true

# Server only, for connecting accounts in the app (onboarding and Settings). ENCRYPTION_KEY is the same value as
# in apps/worker/.env. Stored sign-ins are sealed with the user's own key now; this one only seals the 10 minute
# sign-in cookies and codes, and reads older sign-ins until `pnpm credentials:reseal` has moved them.
ENCRYPTION_KEY=
# Google Cloud OAuth client, application type "Web application", with the authorised redirect URI
# <app origin>/api/connect/google/callback (http://localhost:3000/api/connect/google/callback in development).
# Also add both to apps/worker/.env, which refreshes the sign-ins made with it.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
# Microsoft Entra app, the same MICROSOFT_CLIENT_ID (and MICROSOFT_TENANT, if you set one) as in apps/worker/.env, which
# refreshes the sign-ins made with it. A public client: no secret. Add <app origin>/api/connect/microsoft/callback
# (http://localhost:3000/api/connect/microsoft/callback in development) as a Public client/native redirect URI.
MICROSOFT_CLIENT_ID=

# Zoom Marketplace app (General app, user-managed), with the OAuth redirect URL
# <app origin>/api/connect/zoom/callback (http://localhost:3000/api/connect/zoom/callback in development).
# Also add both to apps/worker/.env, which refreshes the sign-ins made with it.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Instagram, for Business and Creator accounts (the official "Instagram API with Instagram Login"). Create a Meta
# app at developers.facebook.com, add the product Instagram > API setup with Instagram login, and copy its Instagram
# app ID and secret (not the Meta app's). Add the permissions instagram_business_basic and instagram_business_manage_messages, and
# the valid OAuth redirect URI <app origin>/api/connect/instagram/official/callback (Meta wants https, so use a tunnel
# in development). Add each tester under App Roles while the app is in development mode. Without these, the Business
# or Creator choice on the Instagram setup page says "Not available yet". Personal accounts need neither.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Web push: the public half of the pair printed by `pnpm --filter worker vapid:generate` (the same as VAPID_PUBLIC_KEY in
# apps/worker/.env). Without it the Enable Push button in Settings, Notifications stays off.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Attaching files from Google Drive and OneDrive (the Attach menu; a source is left out when its values are empty).
# Google: in the Google Cloud project, enable the Google Picker API and Google Drive API, create an OAuth client ID of type
# "Web application" with the app origin under Authorised JavaScript origins, and an API key restricted to the Picker API
# and the app origin. The scope is drive.file (not restricted, no security review): list it on the consent screen. APP_ID is
# the project number (Project settings), which drive.file needs to grant the chosen files to the app.
NEXT_PUBLIC_GOOGLE_PICKER_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=
# Microsoft: the same value as MICROSOFT_CLIENT_ID above. In the Entra app add the delegated permission Files.Read (users
# consent when they first choose OneDrive) and a "Single-page application" redirect URI <app origin>/attachments/onedrive-callback
# (http://localhost:3000/attachments/onedrive-callback in development), so the browser may redeem the sign-in code.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
