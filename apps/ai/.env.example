SUPABASE_URL=https://bbfahndgnmdlehicmphe.supabase.co
# Service role key, the same one as apps/worker/.env. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Drafts and learning
GEMINI_MODEL=gemini-3.8-flash
# Triage and junk
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Embeddings for finding similar past emails (768 dimensions)
GEMINI_EMBED_MODEL=gemini-embedding-2
# Field encryption. The key that wraps users' data keys, the same as apps/worker/.env (base64, 32 bytes).
# Without it, values the sync worker encrypted cannot be read and are treated as empty.
KEY_WRAPPING_KEY=
# "true" encrypts summaries and drafts this worker writes; anything else writes them as plain text.
ENCRYPT_CONTENT=false

# The same KEY_WRAPPING_KEY as apps/worker/.env, to open encrypted text.
KEY_WRAPPING_KEY=
# "true" stores new summaries and drafts encrypted, together with the sync worker.
ENCRYPT_CONTENT=false

# Instagram (pnpm instagram). The same ENCRYPTION_KEY as apps/worker/.env and apps/web/.env.local: it seals
# the sign-in the app saves and the session the connector keeps.
ENCRYPTION_KEY=
# "true" stores addresses and chat IDs encrypted, together with the sync worker (its ENCRYPT_ADDRESSES).
ENCRYPT_ADDRESSES=
# Optional. Instagram flags sign-ins from data-centre addresses, so a server should go through a home or
# mobile proxy, e.g. http://user:pass@host:port. Keep the same one for an account once it has signed in.
INSTAGRAM_PROXY=
