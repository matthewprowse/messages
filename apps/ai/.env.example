SUPABASE_URL=https://bbfahndgnmdlehicmphe.supabase.co
# Service role key, the same one as apps/worker/.env. Never put it in the web app.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Drafts and learning
GEMINI_MODEL=gemini-3.8-flash
# Triage and junk
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Embeddings for finding similar past emails (768 dimensions)
GEMINI_EMBED_MODEL=gemini-embedding-2
# Field encryption. KEY_WRAPPING_KEY (the old local wrapper) is retired: `pnpm --filter worker keys:readiness` reported
# nothing left under it (4 November 2026). Every data key is wrapped by KMS.
# Google Cloud KMS key that wraps data keys (kms:v1), the same as apps/worker/.env. On a Google Cloud VM the metadata
# server gives the token; elsewhere set GOOGLE_APPLICATION_CREDENTIALS_JSON (a service account key).
KMS_KEY_NAME=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Encryption is ON unless set to "false". The worker refuses to start in production (APP_ENV, ENVIRONMENT or
# NODE_ENV set to production) with either switched off. Keep both the same as apps/worker/.env.
ENCRYPT_CONTENT=true
ENCRYPT_ADDRESSES=true
# The same as in apps/worker/.env: off unless "true". SEAL_BOUND_FIELDS writes values bound to their place ("e2:");
# REQUIRE_BOUND_FIELDS makes the Instagram sends and iCloud Reminders writes refuse the old format after the re-seal.
SEAL_BOUND_FIELDS=
REQUIRE_BOUND_FIELDS=

# Instagram and iCloud Reminders: ENCRYPTION_KEY is retired too; sign-ins and handoffs use the user's own key.
# Optional. Instagram flags sign-ins from data-centre addresses, so a server should go through a home or
# mobile proxy, e.g. http://user:pass@host:port. Keep the same one for an account once it has signed in.
INSTAGRAM_PROXY=
# "true" once the Meta webhook is set up (see apps/web/.env.example, META_WEBHOOK_VERIFY_TOKEN): the connector then reads
# an inbox as soon as a webhook hint arrives and polls only as a safety net. Off: polls about once a minute.
INSTAGRAM_WEBHOOKS=
# "true" once Meta approves Human Agent for the app (and NEXT_PUBLIC_INSTAGRAM_HUMAN_AGENT is set in the web app): a reply
# you write may then go up to 7 days after their last message, with the HUMAN_AGENT tag. Off: 24 hours only.
INSTAGRAM_HUMAN_AGENT=

# "true" works the shared company logo queue together with the sync worker (its COMPANY_LOGOS). Off until rolled out.
COMPANY_LOGOS=

# Cost levers (all optional). Learning (voice, edits, signals, notes on people), the brief script and chasers, and
# automatic pre-drafts default to GEMINI_FAST_MODEL. Meeting recordings default to GEMINI_MODEL.
LEARN_MODEL=
BRIEF_MODEL=
PREDRAFT_MODEL=
GEMINI_TRANSCRIBE_MODEL=
# A second, hedged draft request after a slow first one (3.5s) costs about 12% more on drafts, 1% of AI spend. On unless "false".
DRAFT_HEDGE=true
# Audio input price in dollars per million tokens. An ESTIMATE (audio costs more than text on Gemini); check the pricing page.
AUDIO_INPUT_USD_PER_M=3.00
# Most minutes of one meeting recording, and of one voice note.
MEETING_MAX_MINUTES=240
VOICE_NOTE_MAX_SECONDS=300
# Company logo lookups a day (shared by everyone), and tries per company before giving up for 30 days.
LOGO_DAILY_CAP=200
LOGO_MAX_TRIES=3

# Operations (docs/RUNBOOK.md). HEALTH_PORT serves /healthz, /readyz and /metrics (the Docker image sets 8080; leave it
# unset locally). ERROR_TRACKER_DSN is a Sentry-compatible DSN: only error codes, classes and stack frames are sent, never text.
HEALTH_PORT=
# The address the health endpoint listens on. Unset means 127.0.0.1, which the image's own health check reaches; set
# 0.0.0.0 only where something outside the container must probe it.
HEALTH_HOST=
ERROR_TRACKER_DSN=
