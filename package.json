{
  "name": "messages",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint . && node scripts/check-headers.mjs",
    "worker": "pnpm --filter worker dev",
    "worker:start": "pnpm --filter worker start:prod",
    "connect:icloud": "pnpm --filter worker connect:icloud",
    "connect:imap": "pnpm --filter worker connect:imap",
    "connect:icloud-calendar": "pnpm --filter worker connect:icloud-calendar",
    "connect:google": "pnpm --filter worker connect:google",
    "connect:microsoft": "pnpm --filter worker connect:microsoft",
    "connect:whatsapp": "pnpm --filter worker connect:whatsapp",
    "linkedin:build": "cd apps/linkedin && go build -o bin/konva-linkedin .",
    "test": "pnpm -r test",
    "updates:draft": "node scripts/updates-draft.mjs",
    "set-password": "pnpm --filter worker set-password",
    "ai": "cd apps/ai && python3 -m ai",
    "instagram": "cd apps/ai && python3 -m ai instagram",
    "test:ai": "cd apps/ai && python3 -m unittest discover -s tests -t .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:ai"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3"
  }
}
